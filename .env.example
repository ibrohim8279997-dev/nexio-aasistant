# Скопируйте в .env и заполните:  cp .env.example .env && chmod 600 .env

# Токены ботов агентов от @BotFather. Можно здесь, а надёжнее — зашифрованно в БД:
#   python manage.py agents set-token kimo   (ввод скрыт, хранится в таблице secrets)
KIMO_TOKEN=
ASSISTANT_TOKEN=
AGENT_BUILDER_TOKEN=
# Старое имя токена Кимо (если KIMO_TOKEN не задан)
BOT_TOKEN=
# Ключ Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Ваш Telegram ID (узнать: @userinfobot). Админ пользуется ботом бесплатно.
ADMIN_ID=
# Ключ шифрования Fernet. Сгенерировать: python gen_key.py
ENCRYPTION_KEY=

# Модели и провайдер задаются в конфиге каждого агента (agents/*.json -> таблица agents).
# TEXT_MODEL — запасная текстовая модель, если в конфиге агента модель не указана.
TEXT_MODEL=openai/gpt-oss-120b

# Путь к базе SQLite
DB_PATH=data/bot.db

# Подписка Telegram Stars: false — бот личный (доступ у ADMIN_ID и выданный через /grant), true — продажа включена
SUBSCRIPTION_ENABLED=false
# Веб-поиск Groq (browser_search) для агентов с "search": true
SEARCH_ENABLED=true

# Click через Telegram Payments — заготовка, держите выключенной
CLICK_ENABLED=false
# Токен провайдера Click из @BotFather (можно вместо этого: /setsecret click_provider_token <токен>)
CLICK_PROVIDER_TOKEN=

# Необязательные настройки
# Антиспам: сообщений и нажатий на пользователя в минуту
RATE_LIMIT_PER_MIN=30
SUB_PRICE_XTR=250
SUB_DAYS=30
CLICK_PRICE_UZS=49000
LOG_LEVEL=INFO
