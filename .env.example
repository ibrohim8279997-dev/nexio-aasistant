# Скопируйте в .env и заполните:  cp .env.example .env && chmod 600 .env

# Токены ботов агентов от @BotFather. Можно здесь, а надёжнее — зашифрованно в БД:
#   python manage.py agents set-token kimo   (ввод скрыт, хранится в таблице secrets)
KIMO_TOKEN=
ASSISTANT_TOKEN=
AGENT_BUILDER_TOKEN=
# Старое имя токена Кимо (если KIMO_TOKEN не задан)
BOT_TOKEN=
# Ключ Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Ваш Telegram ID (узнать: @userinfobot). Админ пользуется ботом бесплатно.
ADMIN_ID=
# Ключ шифрования Fernet. Сгенерировать: python gen_key.py
ENCRYPTION_KEY=

# Модели и провайдер задаются в конфиге каждого агента (agents/*.json -> таблица agents).
# TEXT_MODEL — запасная текстовая модель, если в конфиге агента модель не указана.
TEXT_MODEL=openai/gpt-oss-120b

# Путь к базе SQLite
DB_PATH=data/bot.db

# Подписка Telegram Stars: false — бот личный (доступ у ADMIN_ID и выданный через /grant), true — продажа включена
SUBSCRIPTION_ENABLED=false
# Веб-поиск Groq (browser_search) для агентов с "search": true
SEARCH_ENABLED=true

# Click через Telegram Payments — заготовка, держите выключенной
CLICK_ENABLED=false
# Токен провайдера Click из @BotFather (можно вместо этого: /setsecret click_provider_token <токен>)
CLICK_PROVIDER_TOKEN=

# Необязательные настройки
# Антиспам: сообщений и нажатий на пользователя в минуту
RATE_LIMIT_PER_MIN=30
SUB_PRICE_XTR=250
SUB_DAYS=30
CLICK_PRICE_UZS=49000
LOG_LEVEL=INFO

# ---------- Голосовой звонок (voice_sip.py, см. README) ----------
# Логин и пароль, которые вводит Linphone (пароль не короче 8 символов)
SIP_USER=
SIP_PASSWORD=
# Адрес Tailscale этого сервера (100.x.x.x): SIP слушает только его и localhost. Остальные адреса запрещены.
SIP_BIND_ADDRESS=
SIP_PORT=5060
# Куда звонит Кимо: адрес Linphone по Tailscale, например sip:owner@100.x.x.x:5060
SIP_CALLBACK_URI=
# Realm digest-пароля. Если Linphone получает 401 и не присылает пароль (в логе «Authorization нет» без
# второй попытки), поставьте realm равным домену из настроек Linphone, например SIP_REALM=100.119.11.24
# SIP_REALM=kimo
# Запись звонков на диск (data/calls). По умолчанию выключена.
SIP_RECORD_CALLS=false
# Голоса: VOICE_RU=svetlana|dmitry, VOICE_UZ=madina|sardor
VOICE_RU=svetlana
VOICE_UZ=madina
# Голосовые ответы в Telegram: отправили голосовое — получили текст и озвученный ответ. false — только текст.
VOICE_TG_REPLY=true
# Необязательно: максимум звонка (с), тишина до отбоя (с), ожидание ответа Кимо (с), звонок владельцу до отбоя (с)
# VOICE_MAX_CALL_SECONDS=900
# VOICE_IDLE_SECONDS=120
# VOICE_ANSWER_WAIT_SECONDS=20
# VOICE_RING_SECONDS=30

# ---------- Очередь запросов к ИИ (Groq: 30 запросов/мин, 1000/день на весь ключ) ----------
# Одновременных запросов к LLM в одном процессе
# LLM_CONCURRENCY=2
# Лимит обращений к ИИ на пользователя (владельца не касается)
# USER_AI_PER_MIN=6
# USER_AI_PER_DAY=150
