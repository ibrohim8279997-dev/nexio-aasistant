# Скопируйте в .env и заполните:  cp .env.example .env && chmod 600 .env

# Токен бота от @BotFather
BOT_TOKEN=
# Ключ Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Ваш Telegram ID (узнать: @userinfobot). Админ пользуется ботом бесплатно.
ADMIN_ID=
# Ключ шифрования Fernet. Сгенерировать: python gen_key.py
ENCRYPTION_KEY=

# Модели Groq (меняются без правки кода)
TEXT_MODEL=openai/gpt-oss-120b
STT_MODEL=whisper-large-v3-turbo

# Путь к базе SQLite
DB_PATH=data/bot.db

# Click через Telegram Payments — заготовка, держите выключенной
CLICK_ENABLED=false
# Токен провайдера Click из @BotFather (можно вместо этого: /setsecret click_provider_token <токен>)
CLICK_PROVIDER_TOKEN=

# Необязательные настройки
# Антиспам: сообщений и нажатий на пользователя в минуту
RATE_LIMIT_PER_MIN=30
SUB_PRICE_XTR=250
SUB_DAYS=30
CLICK_PRICE_UZS=49000
LOG_LEVEL=INFO
